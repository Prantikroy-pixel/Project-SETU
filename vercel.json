{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_SUPABASE_URL": "<YOUR_SUPABASE_URL>",
    "VITE_SUPABASE_ANON_KEY": "<YOUR_SUPABASE_ANON_KEY>"
  }
}
